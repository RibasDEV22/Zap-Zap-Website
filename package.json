{
  "name": "zapzap",
  "version": "1.1.0",
  "description": "Aplicativo de Chat e WebRTC",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.zapzap.app",
    "productName": "ZapZap",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["portable", "nsis", "dir"],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}